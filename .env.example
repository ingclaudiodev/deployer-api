APP_NAME="deployer.cl"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,slack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Slack: canal #deployer-cluster-alertas (webhook entrante)
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=Deployer
LOG_SLACK_EMOJI=:rotating_light:
LOG_SLACK_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
AUTH_TOKEN_NAME=deployer-client
AUTH_TOKEN_EXPIRE_DAYS=30
AUTH_THROTTLE_PER_MINUTE=10
AUTH_RESET_PASSWORD_PATH=/restablecer

# Second factor at sign-in: a one-time code emailed after the password is accepted.
AUTH_TWO_FACTOR_ENABLED=true
AUTH_TWO_FACTOR_CODE_LENGTH=6
AUTH_TWO_FACTOR_EXPIRE_MINUTES=10
AUTH_TWO_FACTOR_MAX_ATTEMPTS=5
AUTH_TWO_FACTOR_RESEND_SECONDS=60
AUTH_TWO_FACTOR_VERIFY_PER_MINUTE=10
AUTH_TWO_FACTOR_TRUST_DAYS=30

# Servidor de aplicación (Octane). Los valores de workers se leen en docker/entrypoint.sh.
OCTANE_SERVER=swoole
# OCTANE_WORKERS=auto
# OCTANE_TASK_WORKERS=auto
# OCTANE_MAX_REQUESTS=500
# OCTANE_WATCH=false
# RUN_MIGRATIONS=false

# Claves de Passport en producción (contenido PEM). Fuera de producción se generan solas en storage/.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# Puertos publicados por compose.yaml en el host.
# APP_PORT=8000
# FORWARD_REDIS_PORT=6380
# En Docker la base de datos es externa: DB_HOST=host.docker.internal apunta al Postgres del anfitrión.
