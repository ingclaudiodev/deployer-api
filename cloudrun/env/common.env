# Variables NO secretas de la API (Octane), Horizon, migrate y scheduler en Cloud Run. Equivale al
# ConfigMap deployer-api-env de k8s/base/configmap.yaml. render.sh las convierte en `env:` de cada
# contenedor. Formato: CLAVE=valor, sin comillas, una por línea. ${INFRA_IP} lo sustituye deploy.sh
# por la IP interna de la VM. Lo secreto va en Secret Manager (secrets.map).
# Lo propio de cada proceso (OCTANE_WORKERS, PHP_MEMORY_LIMIT...) está en el YAML de cada servicio.

APP_NAME=deployer.cl
# production: el entrypoint corre `optimize`, exige las claves de Passport y Horizon usa su bloque
# 'production'. No cambiar sin revisar docker/entrypoint.sh.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://backend.deployer.cl
FRONTEND_URL=https://deployer.cl
# CORS: en Kubernetes lo contestaba HAProxy; aquí lo hace Laravel (config/cors.php). Sin definir
# CORS_ALLOWED_ORIGINS solo se admite FRONTEND_URL.
# Proxy confiable para X-Forwarded-For/Proto: en Cloud Run el contenedor recibe las peticiones
# desde el rango link-local del propio Cloud Run. Nunca "*". Verificar tras el primer despliegue
# (README, "Verificar") que el throttle ve la IP real del cliente.
TRUSTED_PROXIES=169.254.0.0/16
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs a stderr: Cloud Run los manda a Cloud Logging.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_SLACK_USERNAME=Deployer
LOG_SLACK_EMOJI=:rotating_light:
LOG_SLACK_LEVEL=error

# Base de datos: el Postgres local del Mac, igual que en Kubernetes. El cliente chisel del Mac
# publica su 127.0.0.1:5432 en la VM deployer-infra y Cloud Run entra por la red privada
# (Direct VPC egress). Si el Mac duerme o pierde red: "connection refused". Es la MISMA base
# `deployer` del desarrollo local.
DB_CONNECTION=pgsql
DB_HOST=${INFRA_IP}
DB_PORT=5432
DB_DATABASE=deployer
DB_USERNAME=claudio
DB_SSLMODE=disable

# Redis de la VM deployer-infra: cache, sesiones y colas de Horizon. Con clave (REDIS_PASSWORD en
# Secret Manager) además del firewall.
REDIS_CLIENT=phpredis
REDIS_HOST=${INFRA_IP}
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Horizon corre como sidecar de la API con poca memoria: 2 procesos de hasta 128 MB.
HORIZON_MAX_PROCESSES=2

# Reverb: la API y Horizon publican los eventos por HTTPS al servicio deployer-reverb, por su
# nombre público (no hay red interna entre servicios de Cloud Run).
BROADCAST_CONNECTION=reverb
REVERB_HOST=ws.deployer.cl
REVERB_PORT=443
REVERB_SCHEME=https
AUTH_WELCOME_DELAY_SECONDS=3

# Sin disco persistente: lo que se escribe vive en memoria y muere con la instancia.
FILESYSTEM_DISK=local

# Correo: Zoho ZeptoMail por SMTP (465, TLS implícito). Usuario y token en Secret Manager. El
# remitente DEBE ser exactamente este (guion bajo): con otro, ZeptoMail responde 550.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=465
MAIL_FROM_ADDRESS=no_responder@backend.deployer.cl
MAIL_FROM_NAME=deployer.cl

# Autenticación (mismos valores que .env.example).
AUTH_TOKEN_NAME=deployer-client
AUTH_TOKEN_EXPIRE_DAYS=30
AUTH_THROTTLE_PER_MINUTE=10
AUTH_RESET_PASSWORD_PATH=/restablecer
AUTH_TWO_FACTOR_ENABLED=true
AUTH_TWO_FACTOR_CODE_LENGTH=6
AUTH_TWO_FACTOR_EXPIRE_MINUTES=10
AUTH_TWO_FACTOR_MAX_ATTEMPTS=5
AUTH_TWO_FACTOR_RESEND_SECONDS=60
AUTH_TWO_FACTOR_VERIFY_PER_MINUTE=10
AUTH_TWO_FACTOR_TRUST_DAYS=30
AUTH_TWO_FACTOR_UNVERIFIED_USER_DAYS=7
# Rol (slug de la tabla roles) que recibe toda cuenta nueva.
AUTH_DEFAULT_ROLE=admin

# Octane. Código inmutable en la imagen: sin revalidar opcache. Las migraciones las corre el Job
# deployer-migrate, nunca el arranque del contenedor.
OCTANE_SERVER=swoole
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
RUN_MIGRATIONS=false

# Vertex AI (Gemini) para el agente CloudArchitectAgent. Sin credenciales: la app se autentica
# como la cuenta de servicio del servicio (setup.sh iam le da roles/aiplatform.user).
VERTEX_AI_PROJECT=${PROJECT}
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.8-flash
VERTEX_AI_MAX_OUTPUT_TOKENS=16384
VERTEX_AI_TEMPERATURE=0.2
VERTEX_AI_THINKING_BUDGET=0
VERTEX_AI_TIMEOUT=120
CLOUD_ARCHITECT_MAX_FILES=300
CLOUD_ARCHITECT_MAX_MANIFEST_CHARACTERS=6000
