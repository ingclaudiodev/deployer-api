# Variables NO secretas del servicio deployer-reverb (equivale al ConfigMap reverb-config de
# k8s/reverb/configmap.yaml). Reverb solo necesita bootear Laravel: no usa base de datos, colas ni
# Redis mientras tenga una sola instancia.

APP_NAME=deployer.cl
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
LOG_CHANNEL=stderr
LOG_LEVEL=info
BROADCAST_CONNECTION=reverb
# Dónde escucha el proceso dentro del contenedor (el puerto del YAML).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
# Hostname público que anuncia el servidor.
REVERB_HOST=ws.deployer.cl
REVERB_PORT=443
REVERB_SCHEME=https
# Con más de una instancia cada una ve solo sus sockets y hace falta Redis pub/sub. El servicio
# está limitado a 1 instancia (services/reverb.yaml); para subirlo: "true", REDIS_HOST/REDIS_PASSWORD
# y la red de la VM en el YAML.
REVERB_SCALING_ENABLED=false
# Laravel exige un driver para bootear aunque Reverb no los use.
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/reverb.sqlite
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
RUN_MIGRATIONS=false
# El entrypoint exige claves de Passport en producción; Reverb no las usa.
PASSPORT_PRIVATE_KEY=unused-by-reverb
